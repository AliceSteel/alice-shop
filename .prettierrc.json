{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 80,
  "trailingComma": "none",
  "endOfLine": "auto",
  "vueIndentScriptAndStyle": true,
  "proseWrap": "always",
  "bracketSameLine": false,
  "plugins": ["prettier-plugin-vue"],
  "vueSingleFileComponentOptions": {
    "singleAttributePerLine": true
  }
}
